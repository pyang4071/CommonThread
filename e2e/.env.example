# Copy to .env and fill in your credentials before running tests.
# Never commit .env — it is gitignored.
#
# Use dedicated test accounts, not personal ones: global-setup creates real
# Supabase sessions for them (revoked again by global-teardown).

# A regular (non-admin) Supabase user for authenticated tests.
TEST_EMAIL=you@example.com
TEST_PASSWORD=yourpassword

# An admin user (is_admin = true in app_users) for admin-only tests.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=youradminpassword

# Supabase project — used for magic-link login (when no password is set) and by
# global-teardown to sign the test sessions out. Teardown needs SUPABASE_ANON_KEY
# or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
