# Copy to .env and fill in values — never commit .env

# Supabase project
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Supabase Postgres — use the Session pooler (port 5432) for SQLAlchemy async
# Format: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Crowd promotion threshold — min distinct users to promote a user tag to canonical
CROWD_PROMOTION_THRESHOLD=3

# Allowed CORS origins in staging/production (JSON list).
# In development this is ignored — all origins are allowed.
# Example: CORS_ORIGINS=["https://myapp.com","https://www.myapp.com"]
CORS_ORIGINS=[]
