# =============================================================================
# CommonThread — .gitignore
# =============================================================================


.env
.env.*
*.env
!.env.example

.mcp.json

# Key material
*.pem
*.key
*.p8
*.p12
*.pfx
*.crt
*.cer

# Incident evidence (session IDs, IPs, emails) — keep out of the repo
evid/


# Local-only files (*.local / *.local.* naming convention)
*.local
*.local.*


# Python
__pycache__/
*.py[cod]
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test & coverage
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/

# mypy / pyright / pytype
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/


# Node / Frontend (React + Vite)
node_modules/
.npm/
.yarn/
.pnp.*
.yarn-integrity

# Build output
frontend/dist/
frontend/build/
frontend/.vite/

# TypeScript build artefacts
*.tsbuildinfo


# Playwright / E2E
e2e/.auth/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/
e2e/playwright/.cache/


# Database
# Local SQLite files (used in tests or quick prototyping)
*.db
*.sqlite
*.sqlite3

# Postgres dumps
*.sql.gz
*.dump


# Docker
docker-compose.override.yml
docker-compose.local.yml


# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# Sublime Text
*.sublime-workspace
*.sublime-project


# Logs & temp files
*.log
logs/
tmp/
temp/
.tmp/
.cache/


# ML model cache (fastembed downloads — large binary files, not for VCS)
model_cache/


# Media
*.mp4
*.mov
*.mkv
