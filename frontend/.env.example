# Copy to .env.local for local development, or pass as Docker/Vercel build args.
# These are baked into the JS bundle by Vite at build time.

VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Railway + Vercel split deployment only.
# Set to your Railway backend URL (e.g. https://<service>.up.railway.app).
# Leave unset for Docker Compose or local dev — the Vite proxy / nginx handles /api/* automatically.
VITE_API_BASE_URL=
